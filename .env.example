# Copy to .env and fill in. NEVER commit .env or put these keys in the app.
# Vendors — add either or both; the engine merges catalogues and routes each
# package to the cheapest vendor. With neither set, mock data is served.
ESIMGO_API_KEY=
ESIMACCESS_ACCESS_CODE=
# Keep a vendor's key but exclude it from catalogue + orders (e.g. unfunded account):
# VENDOR_DISABLE=esimgo
VENDOR_DISABLE=
PORT=4000
# For "node server.js sync" (pushes catalogue into Supabase).
# Service role key: Dashboard -> Settings -> API -> service_role. Keep it secret.
SUPABASE_URL=https://acvjjepiyoxzwleggqvs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Delivery email (resend.com). Without a verified domain, Resend only delivers
# to your own account email, from onboarding@resend.dev — fine for testing.
RESEND_API_KEY=
FROM_EMAIL=MobiYatri <onboarding@resend.dev>
# AI setup assistant (console.anthropic.com). Without a key, scripted demo replies.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
# Wholesale USD -> retail INR pricing
USD_INR=88
MARGIN=1.35
